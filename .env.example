RAVE_API_KEY=
RAVE_BASE_URL=https://api.openai.com/v1
RAVE_MODEL=gpt-4.1-mini
RAVE_TEMPERATURE=0.2
RAVE_TIMEOUT_SECONDS=90
RAVE_OUTPUT_DIR=data/runs
RAVE_WEB_SEARCH=true
RAVE_WEB_SEARCH_MODEL=gpt-5-search-api
RAVE_MAX_CONCURRENT_REQUESTS=1
RAVE_WEB_SEARCH_CONTEXT_SIZE=low
RAVE_WEB_SEARCH_MAX_OUTPUT_TOKENS=512
RAVE_ANALYSIS_MAX_OUTPUT_TOKENS=4096

# Run-wide pilot guard (applies to one Hive execution, retries included).
RAVE_MAX_RUN_TOKENS=80000
RAVE_MAX_RUN_SEARCHES=3
RAVE_MAX_RUN_MODEL_CALLS=12
RAVE_MAX_RUN_SECONDS=180
RAVE_MAX_RUN_COST_USD=0.50
RAVE_SEARCH_INPUT_RESERVE_TOKENS=16384

# REQUIRED: GPT-5 Search API rates in USD per 1M tokens.
# Configure from the applicable OpenAI billing/pricing record. No distinct
# GPT-5 Search API token-rate row is published in the public pricing table.
RAVE_SEARCH_INPUT_USD_PER_1M=
RAVE_SEARCH_OUTPUT_USD_PER_1M=
