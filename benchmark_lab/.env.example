# Use a dedicated key for the benchmark lab; never copy RAVE_API_KEY here.
SOLO_API_KEY=
SOLO_BASE_URL=https://api.openai.com/v1
SOLO_MODEL=gpt-4.1-mini
SOLO_WEB_SEARCH_MODEL=gpt-5-search-api
SOLO_TIMEOUT_SECONDS=90
SOLO_TEMPERATURE=0.2
SOLO_MAX_SEARCH_CALLS=3
SOLO_MAX_MODEL_CALLS=12
SOLO_MAX_TOTAL_TOKENS=30000
SOLO_MAX_RUNTIME_SECONDS=600
SOLO_MAX_OUTPUT_TOKENS_PER_CALL=4000
SOLO_OUTPUT_DIR=artifacts/solo_runs
